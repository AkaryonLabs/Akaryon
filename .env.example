AKARYON_ENV=development
AKARYON_HOST=127.0.0.1
AKARYON_PORT=8000
AKARYON_DEFAULT_PROVIDER=mock
AKARYON_DEFAULT_MODEL=mock-default
# echo is fully offline; filesystem_list exercises approvals; fail_once simulates
# one transient provider error so retry behavior can be checked without an API key.
AKARYON_MOCK_SCENARIO=echo
AKARYON_OPENAI_API_KEY=
AKARYON_OPENAI_MODEL=gpt-4o-mini
AKARYON_OPENAI_SEARCH_MODEL=gpt-5-search-api
AKARYON_WEB_SEARCH_COST_RESERVATION_USD=0.30
AKARYON_OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Cost reservations for generated images and vision inputs when a cap is active.
# Vision uses this estimate per attached image; actual usage is recorded when reported.
# Estimates are configurable; final provider charges can differ.
AKARYON_IMAGE_GENERATION_COST_RESERVATION_USD=0.30
AKARYON_IMAGE_INPUT_COST_RESERVATION_USD=0.10
AKARYON_ANTHROPIC_API_KEY=
AKARYON_ANTHROPIC_MODEL=claude-3-5-haiku-latest
AKARYON_OLLAMA_BASE_URL=http://127.0.0.1:11434
AKARYON_OLLAMA_MODEL=llama3.2:3b
# Codex needs a CLI that supports exec --ignore-user-config (0.156.1 is the local probe version).
# Point this to a compatible codex.ps1 path if the global CLI is older.
AKARYON_CODEX_CLI_COMMAND=codex
AKARYON_PROVIDER_TIMEOUT_SECONDS=120
AKARYON_PROVIDER_MAX_OUTPUT_TOKENS=4096
AKARYON_PROVIDER_MAX_TOTAL_OUTPUT_TOKENS=8192
# Optional per-model rates; keys are provider:model and prices are USD per million tokens.
# Example: {"openai:gpt-4o-mini":{"input_usd_per_million":0.15,"output_usd_per_million":0.6}}
AKARYON_MODEL_PRICES_JSON={}
# Optional exact task-type routes, e.g. {"coding":{"provider":"ollama","model":"qwen2.5-coder"}}.
# Pass task_type in /chat or /chat/stream; explicit provider/model wins, unmapped types use default.
# There is no automatic fallback if a configured task route is unavailable.
AKARYON_TASK_PROVIDER_ROUTES_JSON={}
# Optional estimated per-task spend cap; requires a matching entry above for the selected model.
AKARYON_MAX_ESTIMATED_COST_PER_TASK_USD=
# Optional UTC-calendar-month estimated spend cap; requires matching model rates and a persistent database.
AKARYON_MAX_ESTIMATED_COST_PER_MONTH_USD=
AKARYON_MAX_CONTEXT_MESSAGES=40
AKARYON_MAX_CONTEXT_CHARACTERS=60000
AKARYON_MAX_MEMORY_CONTEXT_CHARACTERS=16000
AKARYON_MAX_ATTACHMENT_BYTES=5242880
AKARYON_MAX_ATTACHMENT_CHARACTERS=40000
AKARYON_EMBEDDING_PROVIDER=none
AKARYON_EMBEDDING_MODEL=text-embedding-3-small
AKARYON_OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
AKARYON_DATABASE_URL=
AKARYON_DATABASE_CREATE_TABLES=false
AKARYON_APPROVAL_TOKEN=
AKARYON_ALLOWED_DIRECTORIES=workspace
AKARYON_MAX_FILESYSTEM_FILE_BYTES=1048576
AKARYON_MAX_DIRECTORY_ENTRIES=1000
AKARYON_MAX_TERMINAL_OUTPUT_BYTES=1048576
AKARYON_TERMINAL_ALLOWLIST=git,python,py
AKARYON_AGENT_CAPABILITIES=
# Optional allowlist for approval-gated Windows app control; aliases map to absolute .exe paths.
# AKARYON_DESKTOP_APPS_JSON={"notepad":"C:\\Windows\\System32\\notepad.exe"}
AKARYON_DESKTOP_APPS_JSON={}
AKARYON_LOG_LEVEL=INFO
